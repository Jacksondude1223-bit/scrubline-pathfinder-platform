  "sessions": [
    {
      "id": "contoso-edge",
      "peer_ip": "198.18.0.20",
      "peer_as": 64600,
      "prefixes": ["198.51.100.0/24"],
      "max_prefixes": 4,
      "password": "s3cret-shared",
      "multihop": 2,
