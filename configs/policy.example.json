{
  "name": "game-edge",
  "protected": ["203.0.113.0/24", "203.0.114.10/32"],
  "rules": [
    {
      "id": "tcam-bogon",
      "stage": "asic",
      "action": "drop",
      "priority": 100,
      "match": {"src_cidr": "0.0.0.0/8", "dst_cidr": "203.0.113.0/24"},
      "comment": "TCAM ACL: drop bogon sources before they leave the ASIC"
    },
    {
      "id": "tcam-udp-flood",
      "stage": "asic",
      "action": "drop",
      "priority": 200,
      "match": {"src_cidr": "198.51.100.0/24", "dst_cidr": "203.0.113.0/24", "proto": "udp", "dport": 19132},
      "comment": "TCAM ACL: drop a known UDP flood source toward the game port"
    },
    {
      "id": "fpga-udp-meter",
      "stage": "fpga",
      "action": "rate_limit",
      "priority": 300,
      "pps": 50000,
      "match": {"dst_cidr": "203.0.113.0/24", "proto": "udp"},
      "comment": "FPGA meter: line-rate UDP cap on the protected prefix"
    },
    {
      "id": "fpga-syn",
      "stage": "fpga",
      "action": "rate_limit",
      "priority": 310,
      "pps": 20000,
      "match": {"dst_cidr": "203.0.113.0/24", "proto": "tcp", "tcp_flags": "syn"},
      "comment": "FPGA meter: SYN rate limit"
    },
    {
      "id": "zc-inspect",
      "stage": "zc",
      "action": "inspect",
      "priority": 400,
      "pps": 100000,
      "match": {"dst_cidr": "203.0.113.0/24", "proto": "tcp"},
      "comment": "PF_RING ZC: zero-copy userspace inspect for residual TCP"
    }
  ]
}
