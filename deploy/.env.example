# Copy to deploy/.env for a local demo stack. These are demo values: generate
# your own with `openssl rand -hex 32` for anything that is not a laptop.
#
# The three are deliberately different secrets. Sharing the operator and
# enrollment tokens would give every scrubber control-plane access, which is
# the thing per-node credentials exist to prevent — scrub-api refuses to start
# if they match.
SCRUBLINE_API_TOKEN=demo-operator-token
SCRUBLINE_ENROLL_TOKEN=demo-enroll-token
SCRUBLINE_NODE_API_TOKEN=demo-node-local-token

# Where the published ports bind. Loopback by default: the demo stack runs
# without TLS, so putting it on a routable address puts credentials on the
# wire in the clear. See deploy/README.md before changing this.
BIND_ADDR=127.0.0.1

# Only affects the URL printed in the seed banner.
PUBLIC_URL=http://127.0.0.1:8080
