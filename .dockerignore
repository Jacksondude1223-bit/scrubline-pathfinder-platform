# Keep the build context to what the build needs. Without this, "COPY . ."
# pulls in .git and local build output, so the source layer is invalidated by
# every commit even when no source changed.
.git
bin/
dist/
*.exe
*.test
# Patterns here are anchored at the context root, so .env alone misses deploy/.env, where the
# operator token lives.
**/.env
.DS_Store

target/

**/target/
certs/
